# Copy this file to .env and put your own key after the = sign.
# .env is in .gitignore and is never committed. Never share the key in chat.
GEMINI_API_KEY=

# Optional: force a specific model, e.g. a Gemini 3.x Flash or Flash-Lite model.
# Leave empty to let the app pick the newest Flash / Flash-Lite model your key can use.
GEMINI_MODEL=
